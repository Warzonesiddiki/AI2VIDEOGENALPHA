{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env*": "deny",
      "**/secrets/**": "deny",
      "**/*token*": "deny",
      "**/*credentials*": "deny",
      "*.env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "npm publish*": "deny"
    },
    "skill": "allow",
    "external_directory": "ask"
  }
}
