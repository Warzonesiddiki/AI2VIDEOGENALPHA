# Ternfall Studio - Environment Configuration Example
GEMINI_API_KEY=
NODE_ENV=development
# Local-only by default. Remote access requires a random token of 32+ characters.
HOST=127.0.0.1
PORT=3000
# STUDIO_OPERATOR_TOKEN=
# Remote browser login: username operator, password is the configured token.
# Only use remote access through HTTPS (including the Arena preview proxy).

# Local media execution requires maintained FFmpeg/FFprobe builds with libx264,
# AAC and loudnorm. Defaults to ffmpeg / ffprobe on PATH. Optional absolute paths:
# FFMPEG_PATH=
# FFPROBE_PATH=
